; Open this project with Godot 4.7.2+ .NET.
config_version=5

[application]
config/name="Relick · Sala de práctica"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
config/icon="res://assets/icon.svg"

[display]
window/size/viewport_width=1440
window/size/viewport_height=1024
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/size/min_width=320
window/size/min_height=280

[dotnet]
project/assembly_name="Relick"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.039, 0.047, 0.067, 1)


[input_devices]
pointing/emulate_mouse_from_touch=true
