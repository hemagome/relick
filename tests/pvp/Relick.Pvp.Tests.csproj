<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SpacetimeDB.ClientSDK" Version="2.15.0" />
    <Compile Include="../../network/bindings/**/*.cs" Link="Bindings/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../network/LobbyConnection.cs" Link="LobbyConnection.cs" />
    <Compile Include="../../network/LobbyConnection.QuickMatch.cs" Link="LobbyConnection.QuickMatch.cs" />
    <Compile Include="../../network/AuthSession.cs" Link="AuthSession.cs" />
    <Compile Include="../../network/LobbyConnection.Decks.cs" Link="LobbyConnection.Decks.cs" />
    <Compile Include="../../network/DeckInfo.Style.cs" Link="DeckInfo.Style.cs" />
    <Compile Include="../../core/**/*.cs" Link="Core/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
