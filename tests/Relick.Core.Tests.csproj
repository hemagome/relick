<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="pvp/**/*.cs" />
    <Compile Remove="server/**/*.cs" />
    <None Update="fixtures/**/*.json" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../core/**/*.cs" Link="Core/%(Filename)%(Extension)" />
    <Compile Include="../scripts/Tests/DecisionCommands.cs" Link="DecisionCommands.cs" />
  </ItemGroup>
</Project>

