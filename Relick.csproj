<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition="'$(GodotTargetPlatform)' == 'android'">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="server/**/*.cs" />
    <None Remove="tests/**" />
    <Compile Remove="artifacts/**/*.cs" />
    <None Remove="artifacts/**" />
  </ItemGroup>
  <!-- UI tests and visual previews (scripts/Tests) are compiled only for development; exports leave them out. -->
  <PropertyGroup Condition="!$(Configuration.StartsWith('Export'))">
    <DefineConstants>$(DefineConstants);RELICK_DEV_TOOLS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="$(Configuration.StartsWith('Export'))">
    <Compile Remove="scripts/Tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SpacetimeDB.ClientSDK.Godot" Version="2.15.0" />
  </ItemGroup>
</Project>

